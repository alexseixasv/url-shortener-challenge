# PostgreSQL
POSTGRES_USER=kiip
POSTGRES_PASSWORD=kiip
POSTGRES_DB=kiip
POSTGRES_PORT=5432

# Prisma / API (use localhost when running tools on the host).
# Inside Docker Compose, the api service overrides the host to "postgres".
DATABASE_URL=postgresql://kiip:kiip@localhost:5432/kiip?schema=public

# Redis
REDIS_PORT=6379
# Host tools / local API: localhost. Compose api+worker override to redis://redis:6379
REDIS_URL=redis://localhost:6379

# Analytics worker (defaults are fine for local compose)
# ANALYTICS_CONSUMER_NAME=worker-1
# ANALYTICS_PENDING_IDLE_MS=60000
# ANALYTICS_MAX_ATTEMPTS=5
# ANALYTICS_ENQUEUE_TIMEOUT_MS=0

# Applications (host ports)
API_PORT=3000
WEB_PORT=5173

# Public base URL used to build short links (not the Docker-internal hostname).
# No trailing slash.
SHORT_URL_BASE_URL=http://localhost:3000
